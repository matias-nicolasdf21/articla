# Copia este archivo como .env y completa los valores. El .env NO se sube al repositorio.
POSTGRES_USER=articla
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=articla
# Solo para ejecutar la API fuera de Docker (en Docker se arma sola):
DATABASE_URL=postgresql://articla:cambia_esta_clave@localhost:5432/articla

# Modelo de lenguaje (Google Gemini). Clave gratuita en https://aistudio.google.com/apikey
# Si se deja vacía, Articla funciona igual y responde mostrando los artículos (modo extractivo).
GEMINI_API_KEY=
# Modelos en orden de preferencia: el liviano es rápido y en la evaluación acertó igual
GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest
# Cuánto razona Gemini antes de responder: minimo (rápido), bajo o alto (más lento)
GEMINI_PENSAMIENTO=minimo

# Días que se conservan las consultas antes de borrarse solas
RETENCION_DIAS=90
